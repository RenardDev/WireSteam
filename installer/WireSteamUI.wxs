<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<Fragment>
		<!-- Uses the WiX standard dialogs with a WireSteam-specific navigation flow.
			No product license is invented or accepted by this installer. -->
		<UI Id="WireSteamUI">
			<TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
			<TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
			<TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="10" Bold="yes" />
			<Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

			<DialogRef Id="ErrorDlg" />
			<DialogRef Id="FatalError" />
			<DialogRef Id="PrepareDlg" />
			<DialogRef Id="ProgressDlg" />
			<DialogRef Id="ResumeDlg" />
			<DialogRef Id="UserExit" />
			<DialogRef Id="DiskCostDlg" />

			<Dialog Id="WireSteamOptionsDlg" Width="370" Height="270" Title="WireSteam Setup">
				<Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Text="{\WixUI_Font_Title}Install WireSteam" NoPrefix="yes" />
				<Control Id="Description" Type="Text" X="20" Y="43" Width="330" Height="35" Text="Choose the installation folder. You can select optional tools and a desktop shortcut on the next page." NoPrefix="yes" />
				<Control Id="FolderLabel" Type="Text" X="20" Y="87" Width="330" Height="15" Text="Installation folder:" NoPrefix="yes" />
				<Control Id="Folder" Type="PathEdit" X="20" Y="107" Width="330" Height="20" Property="INSTALLFOLDER" />
				<Control Id="Requirements" Type="Text" X="20" Y="143" Width="330" Height="68" Text="Setup requires the official x64 WireGuard for Windows. Replacing another WireSteam installation stops its components and waits for Internet cleanup. Steam must be signed in to activate a tunnel. Existing profiles and private configurations are kept." NoPrefix="yes" />
				<Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
				<Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
					<Publish Event="NewDialog" Value="WelcomeDlg" />
				</Control>
				<Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
					<Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="1" />
					<Publish Event="NewDialog" Value="CustomizeDlg" Order="2" />
				</Control>
				<Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
					<Publish Event="SpawnDialog" Value="CancelDlg" />
				</Control>
			</Dialog>

			<Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
			<Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="WireSteamOptionsDlg" Condition="NOT Installed" />
			<Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />
			<Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="1" Condition="Installed" />
			<Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="WireSteamOptionsDlg" Order="2" Condition="NOT Installed" />
			<Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="CustomizeDlg" Order="1" Condition="NOT Installed OR WixUI_InstallMode = &quot;Change&quot;" />
			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" Condition="Installed AND PATCH" />
			<Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
			<Publish Dialog="MaintenanceTypeDlg" Control="ChangeButton" Event="NewDialog" Value="CustomizeDlg" />
			<Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
			<Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
			<Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
		</UI>

		<UIRef Id="WixUI_Common" />
	</Fragment>
</Wix>
